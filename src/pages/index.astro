---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Pinnacle Realty — Where the Ocean Meets Opportunity | Umhlanga, Durban">

<!-- ═══════════════════════════════════════════
     NAVIGATION
════════════════════════════════════════════ -->
<header id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-white transition-shadow duration-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between h-18" style="height:72px;">

    <!-- Logo -->
    <a href="#home" class="flex items-center gap-3 flex-shrink-0">
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <polygon points="18,4 32,28 4,28" fill="none" stroke="#1B6CA8" stroke-width="2.5" stroke-linejoin="round"/>
        <polygon points="18,10 27,26 9,26" fill="#D6EAF8"/>
        <line x1="18" y1="4" x2="18" y2="28" stroke="#1B6CA8" stroke-width="1.5"/>
      </svg>
      <div class="leading-tight">
        <div style="font-family:'DM Serif Display',serif;font-size:18px;font-weight:700;color:#1B6CA8;letter-spacing:0.03em;">PINNACLE</div>
        <div style="font-family:'DM Sans',sans-serif;font-size:10px;font-weight:600;letter-spacing:0.18em;color:#1A2332;text-transform:uppercase;">REALTY</div>
      </div>
    </a>

    <!-- Nav Links — Desktop -->
    <nav class="hidden lg:flex items-center gap-8">
      {['Buy','Rent','Commercial','About','Contact'].map(link => (
        <a
          href={`#${link.toLowerCase()}`}
          class="font-body text-sm font-medium text-charcoal hover:text-ocean transition-colors duration-200"
          style="font-family:'DM Sans',sans-serif;color:#1A2332;font-size:14px;font-weight:500;"
          onmouseover="this.style.color='#1B6CA8'"
          onmouseout="this.style.color='#1A2332'"
        >{link}</a>
      ))}
    </nav>

    <!-- Right side -->
    <div class="hidden lg:flex items-center gap-4">
      <a href="tel:0315660800" style="font-family:'DM Sans',sans-serif;font-size:13px;color:#1B6CA8;font-weight:600;">031 566 0800</a>
      <a
        href="#contact"
        style="font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;background:#1B6CA8;color:#fff;padding:10px 20px;border-radius:9999px;letter-spacing:0.03em;white-space:nowrap;transition:background 0.2s ease;"
        onmouseover="this.style.background='#2E8BC0'"
        onmouseout="this.style.background='#1B6CA8'"
      >LIST YOUR PROPERTY</a>
    </div>

    <!-- Hamburger — Mobile -->
    <button id="menu-toggle" class="lg:hidden p-2" aria-label="Open menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1B6CA8" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true">
  <button id="menu-close" class="absolute top-6 right-6 p-2" aria-label="Close menu">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1B6CA8" stroke-width="2" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  {['Home','Buy','Rent','Commercial','About','Contact'].map(link => (
    <a
      href={`#${link.toLowerCase()}`}
      class="mobile-nav-link"
      style="font-family:'DM Serif Display',serif;font-size:32px;color:#1A2332;"
      onmouseover="this.style.color='#1B6CA8'"
      onmouseout="this.style.color='#1A2332'"
    >{link}</a>
  ))}
  <a href="tel:0315660800" style="font-family:'DM Sans',sans-serif;font-size:16px;color:#1B6CA8;font-weight:600;margin-top:16px;">031 566 0800</a>
</div>


<!-- ═══════════════════════════════════════════
     SECTION 1 — HERO
════════════════════════════════════════════ -->
<section id="home" class="hero-split flex" style="min-height:100vh;padding-top:72px;">

  <!-- Left: Content -->
  <div class="hero-left flex flex-col justify-center" style="width:50%;padding:60px 56px 60px 64px;">

    <!-- Badge -->
    <div class="fade-up" style="margin-bottom:28px;">
      <span style="display:inline-flex;align-items:center;gap:8px;background:#EEF4FB;border:1px solid #D6EAF8;color:#1B6CA8;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;padding:8px 18px;border-radius:9999px;letter-spacing:0.02em;">
        🌊 Umhlanga's #1 Property Agency
      </span>
    </div>

    <!-- H1 -->
    <h1 class="fade-up delay-100 hero-h1" style="font-family:'DM Serif Display',serif;font-size:clamp(52px,5.5vw,80px);line-height:1.05;color:#1A2332;margin-bottom:24px;">
      Find Your<br/>
      Perfect<br/>
      <span style="color:#1B6CA8;font-style:italic;">Coastal</span> Home.
    </h1>

    <!-- Subheading -->
    <p class="fade-up delay-200" style="font-family:'DM Sans',sans-serif;font-size:18px;color:#6B7C93;line-height:1.65;max-width:460px;margin-bottom:36px;">
      Premium residential and commercial properties across Umhlanga, La Lucia, Ballito and the KZN North Coast.
    </p>

    <!-- Search Bar -->
    <div class="fade-up delay-300" style="background:#fff;border:1.5px solid #1B6CA8;border-radius:14px;box-shadow:0 8px 40px rgba(27,108,168,0.12);overflow:hidden;margin-bottom:28px;">
      <div class="search-bar-grid flex" style="min-height:60px;">
        <select class="search-input flex-1" style="border:none;padding:16px 20px;font-family:'DM Sans',sans-serif;font-size:14px;color:#1A2332;background:transparent;cursor:pointer;border-right:1px solid #CBD5E1;" aria-label="Location">
          <option value="">📍 Location</option>
          <option>Umhlanga Ridge</option>
          <option>Umhlanga Rocks</option>
          <option>La Lucia</option>
          <option>Ballito</option>
          <option>Salt Rock</option>
          <option>Sheffield Beach</option>
        </select>
        <select class="search-input flex-1" style="border:none;padding:16px 20px;font-family:'DM Sans',sans-serif;font-size:14px;color:#1A2332;background:transparent;cursor:pointer;border-right:1px solid #CBD5E1;" aria-label="Property type">
          <option value="">🏠 Property Type</option>
          <option>House</option>
          <option>Apartment</option>
          <option>Penthouse</option>
          <option>Commercial</option>
          <option>Land</option>
        </select>
        <select class="search-input flex-1" style="border:none;padding:16px 20px;font-family:'DM Sans',sans-serif;font-size:14px;color:#1A2332;background:transparent;cursor:pointer;border-right:1px solid #CBD5E1;" aria-label="Price range">
          <option value="">💰 Price Range</option>
          <option>Under R2M</option>
          <option>R2M — R5M</option>
          <option>R5M — R10M</option>
          <option>R10M — R20M</option>
          <option>R20M+</option>
        </select>
        <button
          style="background:#1B6CA8;color:#fff;padding:16px 28px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:700;letter-spacing:0.06em;border:none;cursor:pointer;white-space:nowrap;transition:background 0.2s ease;"
          onmouseover="this.style.background='#2E8BC0'"
          onmouseout="this.style.background='#1B6CA8'"
          aria-label="Search properties"
        >SEARCH</button>
      </div>
    </div>

    <!-- Stat Pills -->
    <div class="fade-up delay-400 flex flex-wrap gap-3">
      {[
        {val:'240+', label:'Active Listings'},
        {val:'R2.4B+', label:'Sold'},
        {val:'15 Years', label:'in KZN'},
      ].map(s => (
        <div style="display:flex;align-items:center;gap:10px;background:#F7F9FC;border:1px solid #CBD5E1;border-radius:9999px;padding:10px 20px;">
          <span style="font-family:'DM Serif Display',serif;font-size:16px;font-weight:700;color:#1B6CA8;">{s.val}</span>
          <span style="font-family:'DM Sans',sans-serif;font-size:13px;color:#6B7C93;">{s.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Right: Image + Thumbnail cards -->
  <div class="hero-right relative" style="width:50%;position:relative;overflow:hidden;">
    <!-- Main image placeholder -->
    <div style="position:absolute;inset:0;background:linear-gradient(160deg,#1B6CA8 0%,#2E8BC0 40%,#D6EAF8 100%);display:flex;align-items:center;justify-content:center;">
      <div style="text-align:center;">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin:0 auto 16px;opacity:0.4;">
          <rect x="8" y="8" width="48" height="36" rx="4" fill="none" stroke="white" stroke-width="2"/>
          <circle cx="22" cy="22" r="5" fill="white" opacity="0.6"/>
          <path d="M8 32 L20 20 L30 30 L40 22 L56 36" stroke="white" stroke-width="2" fill="none"/>
        </svg>
        <p style="font-family:'DM Serif Display',serif;font-size:22px;font-style:italic;color:rgba(255,255,255,0.7);">[Beachfront Property Photo]</p>
        <p style="font-family:'DM Sans',sans-serif;font-size:13px;color:rgba(255,255,255,0.45);margin-top:8px;letter-spacing:0.08em;">UMHLANGA, KWAZULU-NATAL</p>
      </div>
    </div>

    <!-- Subtle wave overlay -->
    <div style="position:absolute;bottom:0;left:0;right:0;height:120px;background:linear-gradient(to top,rgba(214,234,248,0.3),transparent);pointer-events:none;"></div>

    <!-- Thumbnail cards stacked on the left edge -->
    <div style="position:absolute;left:-120px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:12px;z-index:10;">
      {[
        {price:'R4.2M', loc:'Umhlanga Ridge', idx:0},
        {price:'R12.5M', loc:'La Lucia Beachfront', idx:1},
        {price:'R8.9M', loc:'Umhlanga Rocks', idx:2},
      ].map(t => (
        <div
          class={`thumb-card fade-up delay-${(t.idx+3)*100}`}
          style="width:220px;background:#fff;border-radius:12px;box-shadow:0 8px 32px rgba(27,108,168,0.18);overflow:hidden;display:flex;align-items:stretch;"
        >
          <div style="width:56px;background:linear-gradient(135deg,#1A2332,#2E8BC0);flex-shrink:0;display:flex;align-items:center;justify-content:center;">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="6" width="14" height="10" rx="1" stroke="white" stroke-width="1.5"/><path d="M6 16V11h6v5" stroke="white" stroke-width="1.5"/><path d="M1 7l8-5 8 5" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <div style="padding:10px 14px;">
            <div style="font-family:'DM Serif Display',serif;font-size:14px;font-weight:700;color:#1B6CA8;">{t.price}</div>
            <div style="font-family:'DM Sans',sans-serif;font-size:11px;color:#6B7C93;margin-top:2px;">📍 {t.loc}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     SECTION 2 — PROPERTY SEARCH BAR
════════════════════════════════════════════ -->
<section style="background:#1B6CA8;padding:48px 24px;">
  <div style="max-width:900px;margin:0 auto;text-align:center;">
    <h3 class="fade-up" style="font-family:'DM Serif Display',serif;font-size:clamp(24px,3vw,36px);font-style:italic;color:#fff;margin-bottom:28px;">
      850+ Properties Across the KZN Coast
    </h3>
    <div class="fade-up delay-100 flex flex-wrap justify-center gap-3">
      <button class="filter-pill active" data-filter="all">All Properties</button>
      <button class="filter-pill" data-filter="sale">For Sale</button>
      <button class="filter-pill" data-filter="let">To Let</button>
      <button class="filter-pill" data-filter="commercial">Commercial</button>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     SECTION 3 — FEATURED LISTINGS
════════════════════════════════════════════ -->
<section id="buy" style="background:#ffffff;padding:96px 24px;">
  <div style="max-width:1200px;margin:0 auto;">

    <!-- Header -->
    <div class="fade-up text-center" style="margin-bottom:64px;">
      <span class="section-label">FEATURED LISTINGS</span>
      <h2 style="font-family:'DM Serif Display',serif;font-size:clamp(36px,4vw,56px);color:#1A2332;margin:16px 0 0;line-height:1.1;">
        Handpicked Properties
      </h2>
      <span class="gold-line"></span>
      <p style="font-family:'DM Sans',sans-serif;font-size:17px;color:#6B7C93;margin-top:20px;max-width:520px;margin-left:auto;margin-right:auto;line-height:1.65;">
        Our agents personally curate every listing on Pinnacle Realty.
      </p>
    </div>

    <!-- Grid -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;" class="listings-grid">

      <!-- Card 1 -->
      <article class="prop-card fade-up" style="background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(27,108,168,0.08);overflow:hidden;border:1px solid #f0f4f8;">
        <div style="position:relative;height:240px;overflow:hidden;">
          <div class="card-img" style="height:100%;background:linear-gradient(135deg,#1B6CA8 0%,#2E8BC0 50%,#5BA3CC 100%);display:flex;align-items:center;justify-content:center;">
            <span style="font-family:'DM Serif Display',serif;font-size:15px;font-style:italic;color:rgba(255,255,255,0.7);">[Property Photo]</span>
          </div>
          <span style="position:absolute;top:16px;left:16px;background:#1B6CA8;color:#fff;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.08em;padding:5px 12px;border-radius:9999px;">FOR SALE</span>
          <button class="heart-icon" style="position:absolute;top:14px;right:14px;background:rgba(255,255,255,0.9);border:none;border-radius:9999px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;" aria-label="Save property">♡</button>
        </div>
        <div style="padding:20px;">
          <div style="font-family:'DM Serif Display',serif;font-size:22px;font-weight:700;color:#1B6CA8;margin-bottom:6px;">R4,200,000</div>
          <div style="font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;color:#1A2332;margin-bottom:6px;">The Umhlanga Ridge Penthouse</div>
          <div style="font-family:'DM Sans',sans-serif;font-size:13px;color:#6B7C93;margin-bottom:16px;">📍 Umhlanga Ridge, Durban</div>
          <div style="display:flex;gap:0;border-top:1px solid #EEF4FB;padding-top:14px;margin-bottom:14px;">
            {[['🛏','3 Beds'],['🚿','2 Baths'],['📐','210m²'],['🚗','2']].map((f,i) => (
              <span style="font-family:'DM Sans',sans-serif;font-size:12px;color:#6B7C93;flex:1;text-align:center;border-right:i<3?'1px solid #CBD5E1':'none';">
                {f[0]} {f[1]}
              </span>
            ))}
          </div>
          <div style="border-top:1px solid #EEF4FB;padding-top:14px;display:flex;align-items:center;justify-content:space-between;">
            <a href="#" class="view-link" style="font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;color:#1B6CA8;text-decoration:none;">View Property →</a>
            <div style="width:32px;height:32px;border-radius:9999px;background:linear-gradient(135deg,#1B6CA8,#2E8BC0);display:flex;align-items:center;justify-content:center;font-family:'DM Serif Display',serif;font-size:12px;color:#fff;">TK</div>
          </div>
        </div>
      </article>

      <!-- Card 2 -->
      <article class="prop-card fade-up delay-100" style="background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(27,108,168,0.08);overflow:hidden;border:1px solid #f0f4f8;">
        <div style="position:relative;height:240px;overflow:hidden;">
          <div class="card-img" style="height:100%;background:linear-gradient(135deg,#0d4a7a 0%,#1B6CA8 40%,#2E8BC0 100%);display:flex;align-items:center;justify-content:center;">
            <span style="font-family:'DM Serif Display',serif;font-size:15px;font-style:italic;color:rgba(255,255,255,0.7);">[Property Photo]</span>
          </div>
          <span style="position:absolute;top:16px;left:16px;background:#1B6CA8;color:#fff;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.08em;padding:5px 12px;border-radius:9999px;">FOR SALE</span>
          <button class="heart-icon" style="position:absolute;top:14px;right:14px;background:rgba(255,255,255,0.9);border:none;border-radius:9999px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;" aria-label="Save property">♡</button>
        </div>
        <div style="padding:20px;">
          <div style="font-family:'DM Serif Display',serif;font-size:22px;font-weight:700;color:#1B6CA8;margin-bottom:6px;">R12,500,000</div>
          <div style="font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;color:#1A2332;margin-bottom:6px;">La Lucia Beachfront Villa</div>
          <div style="font-family:'DM Sans',sans-serif;font-size:13px;color:#6B7C93;margin-bottom:16px;">📍 La Lucia, Durban North</div>
          <div style="display:flex;border-top:1px solid #EEF4FB;padding-top:14px;margin-bottom:14px;">
            {[['🛏','5 Beds'],['🚿','4 Baths'],['📐','480m²'],['🚗','4']].map((f,i) => (
              <span style="font-family:'DM Sans',sans-serif;font-size:12px;color:#6B7C93;flex:1;text-align:center;border-right:i<3?'1px solid #CBD5E1':'none';">
                {f[0]} {f[1]}
              </span>
            ))}
          </div>
          <div style="border-top:1px solid #EEF4FB;padding-top:14px;display:flex;align-items:center;justify-content:space-between;">
            <a href="#" class="view-link" style="font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;color:#1B6CA8;text-decoration:none;">View Property →</a>
            <div style="width:32px;height:32px;border-radius:9999px;background:linear-gradient(135deg,#0d4a7a,#1B6CA8);display:flex;align-items:center;justify-content:center;font-family:'DM Serif Display',serif;font-size:12px;color:#fff;">SK</div>
          </div>
        </div>
      </article>

      <!-- Card 3 -->
      <article class="prop-card fade-up delay-200" style="background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(27,108,168,0.08);overflow:hidden;border:1px solid #f0f4f8;">
        <div style="position:relative;height:240px;overflow:hidden;">
          <div class="card-img" style="height:100%;background:linear-gradient(135deg,#2E8BC0 0%,#5BA3CC 50%,#D6EAF8 100%);display:flex;align-items:center;justify-content:center;">
            <span style="font-family:'DM Serif Display',serif;font-size:15px;font-style:italic;color:rgba(255,255,255,0.7);">[Property Photo]</span>
          </div>
          <span style="position:absolute;top:16px;left:16px;background:#C9A84C;color:#fff;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.08em;padding:5px 12px;border-radius:9999px;">TO LET</span>
          <button class="heart-icon" style="position:absolute;top:14px;right:14px;background:rgba(255,255,255,0.9);border:none;border-radius:9999px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;" aria-label="Save property">♡</button>
        </div>
        <div style="padding:20px;">
          <div style="font-family:'DM Serif Display',serif;font-size:22px;font-weight:700;color:#1B6CA8;margin-bottom:6px;">R28,000<span style="font-size:14px;font-weight:400;color:#6B7C93;">/month</span></div>
          <div style="font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;color:#1A2332;margin-bottom:6px;">Modern Umhlanga Apartment</div>
          <div style="font-family:'DM Sans',sans-serif;font-size:13px;color:#6B7C93;margin-bottom:16px;">📍 Umhlanga Rocks, Durban</div>
          <div style="display:flex;border-top:1px solid #EEF4FB;padding-top:14px;margin-bottom:14px;">
            {[['🛏','2 Beds'],['🚿','2 Baths'],['📐','95m²'],['🚗','1']].map((f,i) => (
              <span style="font-family:'DM Sans',sans-serif;font-size:12px;color:#6B7C93;flex:1;text-align:center;border-right:i<3?'1px solid #CBD5E1':'none';">
                {f[0]} {f[1]}
              </span>
            ))}
          </div>
          <div style="border-top:1px solid #EEF4FB;padding-top:14px;display:flex;align-items:center;justify-content:space-between;">
            <a href="#" class="view-link" style="font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;color:#1B6CA8;text-decoration:none;">View Property →</a>
            <div style="width:32px;height:32px;border-radius:9999px;background:linear-gradient(135deg,#2E8BC0,#5BA3CC);display:flex;align-items:center;justify-content:center;font-family:'DM Serif Display',serif;font-size:12px;color:#fff;">PN</div>
          </div>
        </div>
      </article>

      <!-- Card 4 -->
      <article class="prop-card fade-up" style="background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(27,108,168,0.08);overflow:hidden;border:1px solid #f0f4f8;">
        <div style="position:relative;height:240px;overflow:hidden;">
          <div class="card-img" style="height:100%;background:linear-gradient(135deg,#1A2332 0%,#1B6CA8 60%,#2E8BC0 100%);display:flex;align-items:center;justify-content:center;">
            <span style="font-family:'DM Serif Display',serif;font-size:15px;font-style:italic;color:rgba(255,255,255,0.7);">[Property Photo]</span>
          </div>
          <span style="position:absolute;top:16px;left:16px;background:#1A2332;color:#fff;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.08em;padding:5px 12px;border-radius:9999px;">COMMERCIAL</span>
          <button class="heart-icon" style="position:absolute;top:14px;right:14px;background:rgba(255,255,255,0.9);border:none;border-radius:9999px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;" aria-label="Save property">♡</button>
        </div>
        <div style="padding:20px;">
