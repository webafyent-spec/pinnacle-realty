<!-- ═══════════════════════════════════════════
     JAVASCRIPT
════════════════════════════════════════════ -->
<script define:vars={{ properties }}>

  // ── Nav shadow
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('nav-shadow', window.scrollY > 10);
  }, { passive: true });

  // ── Mobile menu
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  document.getElementById('menu-close')?.addEventListener('click', closeMenuFn);
  menuToggle?.addEventListener('click', () => {
    mobileMenu?.classList.add('open');
    document.body.style.overflow = 'hidden';
  });
  mobileMenu?.querySelectorAll('.mobile-nav-link').forEach(l => l.addEventListener('click', closeMenuFn));
  function closeMenuFn() {
    mobileMenu?.classList.remove('open');
    document.body.style.overflow = '';
  }

  // ── Fade-up observer
  const fadeObs = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); fadeObs.unobserve(e.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
  document.querySelectorAll('.fade-up').forEach(el => fadeObs.observe(el));

  // ── Counter animation
  function animateCounter(el, target) {
    const m = target.match(/[\d.]+/);
    if (!m) return;
    const num = parseFloat(m[0]);
    const prefix = target.replace(/[\d.]+.*/, '');
    const suffix = target.replace(/^[^0-9]*[\d.]+/, '');
    const dur = 1800, t0 = performance.now();
    (function tick(now) {
      const p = Math.min((now - t0) / dur, 1);
      const v = Math.round((1 - Math.pow(1 - p, 3)) * num * 10) / 10;
      el.textContent = prefix + (Number.isInteger(num) ? Math.round(v) : v) + suffix;
      if (p < 1) requestAnimationFrame(tick);
    })(t0);
  }
  const statObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) { animateCounter(e.target, e.target.dataset.target); statObs.unobserve(e.target); }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.counter').forEach(el => statObs.observe(el));

  // ── Hero image switcher
  const heroPanels = document.querySelectorAll('.hero-panel');
  const heroThumbs = document.querySelectorAll('.hero-thumb');
  const heroLocEl = document.getElementById('hero-active-location');
  const heroSubEl = document.getElementById('hero-active-sublabel');
  function activatePanel(idx) {
    heroPanels.forEach((p, i) => { p.classList.toggle('active', i === idx); p.setAttribute('aria-hidden', i !== idx ? 'true' : 'false'); });
    heroThumbs.forEach(t => t.classList.remove('thumb-active'));
    heroThumbs[idx]?.classList.add('thumb-active');
    const ap = heroPanels[idx];
    if (heroLocEl) heroLocEl.textContent = ap?.dataset.location ?? '';
    if (heroSubEl) heroSubEl.textContent = ap?.dataset.sublabel ?? '';
  }
  const isTouch = () => window.matchMedia('(hover: none)').matches;
  heroThumbs.forEach(t => {
    t.addEventListener('mouseenter', () => { if (!isTouch()) activatePanel(Number(t.dataset.panel)); });
    t.addEventListener('click', () => { if (isTouch()) activatePanel(Number(t.dataset.panel)); });
  });

  // ══════════════════════════════════════════
  // FAVOURITES — localStorage persistence
  // ══════════════════════════════════════════
  const FAVS_KEY = 'pinnacle_favourites';
  function getFavs() {
    try { return JSON.parse(localStorage.getItem(FAVS_KEY) || '[]'); } catch { return []; }
  }
  function toggleFav(id) {
    const favs = getFavs();
    const idx = favs.indexOf(id);
    if (idx > -1) favs.splice(idx, 1); else favs.push(id);
    localStorage.setItem(FAVS_KEY, JSON.stringify(favs));
    return idx === -1; // true = just added
  }
  function syncHeartBtn(btn, isSaved) {
    btn.textContent = isSaved ? '♥' : '♡';
    btn.style.color = isSaved ? '#e74c3c' : '';
    btn.dataset.saved = isSaved ? 'true' : 'false';
  }
  // Init hearts on load
  const favs = getFavs();
  document.querySelectorAll('.heart-icon').forEach(btn => {
    const id = Number(btn.dataset.id);
    syncHeartBtn(btn, favs.includes(id));
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const added = toggleFav(id);
      syncHeartBtn(btn, added);
      // also sync modal heart if open
      const modalHeart = document.getElementById('modal-heart');
      if (modalHeart && Number(modalHeart.dataset.id) === id) syncHeartBtn(modalHeart, added);
    });
  });

  // ══════════════════════════════════════════
  // FILTERING — filter pills + search
  // ══════════════════════════════════════════
  let currentFilter = { type: 'all', location: '', priceMin: 0, priceMax: Infinity };

  function applyFilter() {
    const cards = document.querySelectorAll('.prop-card');
    const noResults = document.getElementById('no-results');
    const heading = document.getElementById('listings-heading');
    let visible = 0;

    cards.forEach(card => {
      const type = card.dataset.type;
      const loc = card.dataset.location;
      const price = Number(card.dataset.priceNum);

      const typeMatch = currentFilter.type === 'all' || type === currentFilter.type;
      const locMatch = !currentFilter.location || loc === currentFilter.location;
      const priceMatch = price >= currentFilter.priceMin && price <= currentFilter.priceMax;

      const show = typeMatch && locMatch && priceMatch;
      card.classList.toggle('hidden-card', !show);
      if (show) visible++;
    });

    noResults?.classList.toggle('visible', visible === 0);

    // Update count label
    const countEl = document.getElementById('results-count');
    if (countEl) {
      countEl.textContent = visible < 6 ? `Showing ${visible} of ${cards.length} properties` : '';
    }

    // Update heading
    if (heading) {
      const labels = { all: 'Handpicked Properties', sale: 'Properties For Sale', let: 'Properties To Let', commercial: 'Commercial Properties' };
      heading.textContent = labels[currentFilter.type] || 'Handpicked Properties';
    }
  }

  // Filter pills
  document.querySelectorAll('.filter-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      currentFilter = { type: pill.dataset.filter, location: '', priceMin: 0, priceMax: Infinity };
      // Reset search selects
      document.getElementById('search-location').value = '';
      document.getElementById('search-type').value = '';
      document.getElementById('search-price').value = '';
      applyFilter();
    });
  });

  // Search button
  document.getElementById('search-btn')?.addEventListener('click', () => {
    const loc = document.getElementById('search-location')?.value || '';
    const type = document.getElementById('search-type')?.value || '';
    const priceVal = document.getElementById('search-price')?.value || '';
    let priceMin = 0, priceMax = Infinity;
    if (priceVal) { const [a, b] = priceVal.split('-').map(Number); priceMin = a; priceMax = b; }

    currentFilter = { type: type || 'all', location: loc, priceMin, priceMax };

    // Sync filter pills
    document.querySelectorAll('.filter-pill').forEach(p => {
      p.classList.toggle('active', p.dataset.filter === (type || 'all'));
    });

    applyFilter();
    document.getElementById('buy')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // View All button
  document.getElementById('view-all-btn')?.addEventListener('click', () => {
    currentFilter = { type: 'all', location: '', priceMin: 0, priceMax: Infinity };
    document.querySelectorAll('.filter-pill').forEach(p => p.classList.toggle('active', p.dataset.filter === 'all'));
    document.getElementById('search-location').value = '';
    document.getElementById('search-type').value = '';
    document.getElementById('search-price').value = '';
    applyFilter();
  });

  // Clear filters btn (no results state)
  document.getElementById('clear-filters-btn')?.addEventListener('click', () => {
    currentFilter = { type: 'all', location: '', priceMin: 0, priceMax: Infinity };
    document.querySelectorAll('.filter-pill').forEach(p => p.classList.toggle('active', p.dataset.filter === 'all'));
    applyFilter();
  });

  // Footer filter + scroll helper (global)
  window.filterAndScroll = function(type) {
    currentFilter = { type, location: '', priceMin: 0, priceMax: Infinity };
    document.querySelectorAll('.filter-pill').forEach(p => p.classList.toggle('active', p.dataset.filter === type));
    applyFilter();
    document.getElementById('buy')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  // ══════════════════════════════════════════
  // PROPERTY MODAL
  // ══════════════════════════════════════════
  const modal = document.getElementById('property-modal');
  const modalContent = document.getElementById('modal-content');

  function openModal(id) {
    const p = properties.find(x => x.id === id);
    if (!p) return;

    // Image
    document.getElementById('modal-img-bg').style.background = p.imgGrad;
    // Badge
    const badge = document.getElementById('modal-badge');
    badge.textContent = p.badge;
    badge.style.background = p.badgeColor;
    badge.style.color = '#fff';
    // Price & name
    document.getElementById('modal-price').textContent = p.price;
    document.getElementById('modal-name').textContent = p.name;
    document.getElementById('modal-location').textContent = '📍 ' + p.location;
    // Description
    document.getElementById('modal-desc').textContent = p.desc;

    // Features bar
    const bar = document.getElementById('modal-features-bar');
    bar.innerHTML = '';
    const feats = p.type === 'commercial'
      ? [['🏢','Open Plan'],['📐',p.size+'m²'],['🚗',p.parking+' Parking'],['✓','A-Grade']]
      : [['🛏',p.beds+' Beds'],['🚿',p.baths+' Baths'],['📐',p.size+'m²'],['🚗',p.parking+' Parking']];
    feats.forEach(([icon, label], i) => {
      bar.innerHTML += `<div style="flex:1;padding:14px 8px;text-align:center;${i<3?'border-right:1px solid #EEF4FB':''}"><div style="font-size:20px;margin-bottom:4px;">${icon}</div><div style="font-family:'DM Sans',sans-serif;font-size:12px;color:#6B7C93;">${label}</div></div>`;
    });

    // Feature tags
    const tags = document.getElementById('modal-tags');
    tags.innerHTML = p.features.map(f => `<span style="background:#EEF4FB;color:#1B6CA8;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:600;padding:6px 14px;border-radius:9999px;">${f}</span>`).join('');

    // Agent
    const waMsg = encodeURIComponent(`Hi ${p.agentName}, I'm interested in "${p.name}" listed at ${p.price} on Pinnacle Realty. Could you please send me more details?`);
    document.getElementById('modal-agent').innerHTML = `
      <div style="width:52px;height:52px;border-radius:50%;background:${p.agentGrad};display:flex;align-items:center;justify-content:center;font-family:'DM Serif Display',serif;font-size:18px;color:#fff;flex-shrink:0;">${p.agentInit}</div>
      <div>
        <div style="font-family:'DM Serif Display',serif;font-size:15px;color:#1A2332;">${p.agentName}</div>
        <div style="font-family:'DM Sans',sans-serif;font-size:11px;color:#6B7C93;margin-top:2px;">${p.agentTitle}</div>
      </div>`;
    document.getElementById('modal-whatsapp').href = `https://wa.me/${p.agentPhone.replace('tel:+','')}?text=${waMsg}`;
    document.getElementById('modal-call').href = p.agentPhone;

    // Heart state
    const modalHeart = document.getElementById('modal-heart');
    modalHeart.dataset.id = id;
    syncHeartBtn(modalHeart, getFavs().includes(id));
    modalHeart.onclick = () => {
      const added = toggleFav(id);
      syncHeartBtn(modalHeart, added);
      // sync card heart
      const cardHeart = document.querySelector(`.heart-icon[data-id="${id}"]`);
      if (cardHeart) syncHeartBtn(cardHeart, added);
    };

    // Show modal
    modal.style.display = 'block';
    document.body.style.overflow = 'hidden';
    setTimeout(() => modalContent.style.transform = 'none', 10);
  }

  window.closeModal = function() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  };

  document.getElementById('modal-close')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', e => { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && modal.style.display === 'block') closeModal(); });

  // Wire "View Property" buttons
  document.querySelectorAll('.open-modal').forEach(btn => {
    btn.addEventListener('click', () => openModal(Number(btn.dataset.id)));
  });

  // ══════════════════════════════════════════
  // FORM SUBMISSIONS — success states
  // ══════════════════════════════════════════
  document.getElementById('valuation-form')?.addEventListener('submit', e => {
    e.preventDefault();
    const form = e.target;
    form.style.display = 'none';
    document.getElementById('valuation-success').style.display = 'block';
  });

  document.getElementById('contact-form')?.addEventListener('submit', e => {
    e.preventDefault();
    const form = e.target;
    form.style.display = 'none';
    document.getElementById('contact-success').style.display = 'block';
  });

  // ── WhatsApp FAB pulse on load
  const fab = document.getElementById('whatsapp-fab');
  setTimeout(() => {
    fab?.animate([
      { transform:'scale(1)' },
      { transform:'scale(1.15)' },
      { transform:'scale(1)' },
    ], { duration: 600, easing:'ease-in-out' });
  }, 3000);

</script>

</Layout>
