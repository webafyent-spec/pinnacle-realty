---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

// ── Property data — single source of truth
const properties = [
  {
    id: 1, type: 'sale', badge: 'FOR SALE', badgeColor: '#1B6CA8',
    price: 'R4,200,000', priceNum: 4200000,
    name: 'The Umhlanga Ridge Penthouse',
    location: 'Umhlanga Ridge, Durban', locationKey: 'umhlanga-ridge',
    beds: 3, baths: 2, size: 210, parking: 2,
    desc: 'A stunning penthouse perched atop Umhlanga Ridge with panoramic Indian Ocean views. Open-plan living, designer finishes and wraparound balcony. One of Umhlanga\'s most coveted addresses.',
    features: ['Ocean Views','Rooftop Terrace','Underfloor Heating','Smart Home','24hr Security','Pool'],
    agentInit: 'TK', agentName: 'Thabo Khumalo', agentTitle: 'Senior Property Specialist',
    agentPhone: 'tel:+27315660800', agentEmail: 'mailto:thabo@pinnaclerealty.co.za',
    imgGrad: 'linear-gradient(135deg,#1B6CA8 0%,#2E8BC0 50%,#5BA3CC 100%)',
    agentGrad: 'linear-gradient(135deg,#1B6CA8,#2E8BC0)',
  },
  {
    id: 2, type: 'sale', badge: 'FOR SALE', badgeColor: '#1B6CA8',
    price: 'R12,500,000', priceNum: 12500000,
    name: 'La Lucia Beachfront Villa',
    location: 'La Lucia, Durban North', locationKey: 'la-lucia',
    beds: 5, baths: 4, size: 480, parking: 4,
    desc: 'An architectural masterpiece set directly on the La Lucia beachfront. Infinity pool, lush tropical garden, private beach access and breathtaking Indian Ocean views. Entertainer\'s paradise.',
    features: ['Private Beach Access','Infinity Pool','Tropical Garden','Staff Quarters','Wine Cellar','Home Cinema'],
    agentInit: 'SK', agentName: 'Samantha Kruger', agentTitle: 'Coastal Residential Expert',
    agentPhone: 'tel:+27315660801', agentEmail: 'mailto:samantha@pinnaclerealty.co.za',
    imgGrad: 'linear-gradient(135deg,#0d4a7a 0%,#1B6CA8 40%,#2E8BC0 100%)',
    agentGrad: 'linear-gradient(135deg,#0d4a7a,#1B6CA8)',
  },
  {
    id: 3, type: 'let', badge: 'TO LET', badgeColor: '#C9A84C',
    price: 'R28,000/month', priceNum: 28000,
    name: 'Modern Umhlanga Apartment',
    location: 'Umhlanga Rocks, Durban', locationKey: 'umhlanga-rocks',
    beds: 2, baths: 2, size: 95, parking: 1,
    desc: 'Sleek, contemporary apartment in the heart of Umhlanga Rocks. Walking distance to Gateway Theatre of Shopping, Umhlanga promenade and the beach. Perfect for professionals or couples.',
    features: ['Sea Views','Gym Access','Concierge','Fibre Internet','Balcony','Pool'],
    agentInit: 'PN', agentName: 'Priya Naidoo', agentTitle: 'Commercial Property Specialist',
    agentPhone: 'tel:+27315660802', agentEmail: 'mailto:priya@pinnaclerealty.co.za',
    imgGrad: 'linear-gradient(135deg,#2E8BC0 0%,#5BA3CC 50%,#D6EAF8 100%)',
    agentGrad: 'linear-gradient(135deg,#2E8BC0,#5BA3CC)',
  },
  {
    id: 4, type: 'commercial', badge: 'COMMERCIAL', badgeColor: '#1A2332',
    price: 'R3,800,000', priceNum: 3800000,
    name: 'Gateway Business Park Office',
    location: 'Umhlanga, Durban', locationKey: 'umhlanga',
    beds: 0, baths: 0, size: 320, parking: 8,
    desc: 'Prime A-grade office space in the prestigious Gateway Business Park. Open-plan layout with floor-to-ceiling glass, stunning views, 8 basement parking bays and immediate occupation available.',
    features: ['A-Grade Building','Fibre Ready','Generator Backup','Reception Area','Board Room','8 Parking Bays'],
    agentInit: 'PN', agentName: 'Priya Naidoo', agentTitle: 'Commercial Property Specialist',
    agentPhone: 'tel:+27315660802', agentEmail: 'mailto:priya@pinnaclerealty.co.za',
    imgGrad: 'linear-gradient(135deg,#1A2332 0%,#1B6CA8 60%,#2E8BC0 100%)',
    agentGrad: 'linear-gradient(135deg,#1A2332,#2E8BC0)',
  },
  {
    id: 5, type: 'sale', badge: 'FOR SALE', badgeColor: '#1B6CA8',
    price: 'R8,900,000', priceNum: 8900000,
    name: 'Ballito Coastal Estate Home',
    location: 'Ballito, KZN North Coast', locationKey: 'ballito',
    beds: 4, baths: 3, size: 380, parking: 3,
    desc: 'Exceptional family home within a prestigious Ballito coastal estate. Generous open-plan living, chef\'s kitchen, landscaped garden with pool and triple garage. Secure 24hr estate living.',
    features: ['Gated Estate','Pool & Garden','Chef\'s Kitchen','Covered Patio','Solar Backup','3 Car Garage'],
    agentInit: 'MC', agentName: 'Michael Clarke', agentTitle: 'North Coast Specialist',
    agentPhone: 'tel:+27315660803', agentEmail: 'mailto:michael@pinnaclerealty.co.za',
    imgGrad: 'linear-gradient(135deg,#1B6CA8 0%,#5BA3CC 40%,#aac9e3 100%)',
    agentGrad: 'linear-gradient(135deg,#1B6CA8,#5BA3CC)',
  },
  {
    id: 6, type: 'let', badge: 'TO LET', badgeColor: '#C9A84C',
    price: 'R45,000/month', priceNum: 45000,
    name: 'Penthouse — The Pearls, Umhlanga',
    location: 'The Pearls, Umhlanga', locationKey: 'umhlanga',
    beds: 4, baths: 3, size: 320, parking: 2,
    desc: 'The crown jewel of The Pearls — Umhlanga\'s most prestigious residential address. This full-floor penthouse offers uninterrupted 270° ocean views, private rooftop terrace and world-class finishes.',
    features: ['270° Ocean Views','Private Rooftop','Concierge Service','Smart Home','Wine Room','2 Parking Bays'],
    agentInit: 'SK', agentName: 'Samantha Kruger', agentTitle: 'Coastal Residential Expert',
    agentPhone: 'tel:+27315660801', agentEmail: 'mailto:samantha@pinnaclerealty.co.za',
    imgGrad: 'linear-gradient(135deg,#0a3d68 0%,#1B6CA8 30%,#2E8BC0 70%,#5BA3CC 100%)',
    agentGrad: 'linear-gradient(135deg,#0a3d68,#1B6CA8)',
  },
];
---

<Layout title="Pinnacle Realty — Where the Ocean Meets Opportunity | Umhlanga, Durban">

<!-- ═══════════════════════════════════════════
     NAVIGATION
════════════════════════════════════════════ -->
<header id="navbar" class="fixed top-0 left-0 right-0 z-50 bg-white transition-shadow duration-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center justify-between" style="height:72px;">
    <a href="#home" class="flex items-center gap-3 flex-shrink-0">
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
        <polygon points="18,4 32,28 4,28" fill="none" stroke="#1B6CA8" stroke-width="2.5" stroke-linejoin="round"/>
        <polygon points="18,10 27,26 9,26" fill="#D6EAF8"/>
        <line x1="18" y1="4" x2="18" y2="28" stroke="#1B6CA8" stroke-width="1.5"/>
      </svg>
      <div class="leading-tight">
        <div style="font-family:'DM Serif Display',serif;font-size:18px;font-weight:700;color:#1B6CA8;letter-spacing:0.03em;">PINNACLE</div>
        <div style="font-family:'DM Sans',sans-serif;font-size:10px;font-weight:600;letter-spacing:0.18em;color:#1A2332;text-transform:uppercase;">REALTY</div>
      </div>
    </a>
    <nav class="hidden lg:flex items-center gap-8">
      {['Buy','Rent','Commercial','About','Contact'].map(link => (
        <a href={`#${link.toLowerCase()}`} class="nav-link" style="font-family:'DM Sans',sans-serif;color:#1A2332;font-size:14px;font-weight:500;">{link}</a>
      ))}
    </nav>
    <div class="hidden lg:flex items-center gap-4">
      <a href="tel:0315660800" style="font-family:'DM Sans',sans-serif;font-size:13px;color:#1B6CA8;font-weight:600;">031 566 0800</a>
      <a href="#contact" class="btn-ocean" style="font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;padding:10px 20px;border-radius:9999px;letter-spacing:0.03em;white-space:nowrap;">LIST YOUR PROPERTY</a>
    </div>
    <button id="menu-toggle" class="lg:hidden p-2" aria-label="Open menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1B6CA8" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Menu -->
<div id="mobile-menu" class="mobile-menu" role="dialog" aria-modal="true">
  <button id="menu-close" class="absolute top-6 right-6 p-2" aria-label="Close menu">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1B6CA8" stroke-width="2" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  {['Home','Buy','Rent','Commercial','About','Contact'].map(link => (
    <a href={`#${link.toLowerCase()}`} class="mobile-nav-link" style="font-family:'DM Serif Display',serif;font-size:32px;color:#1A2332;">{link}</a>
  ))}
  <a href="tel:0315660800" style="font-family:'DM Sans',sans-serif;font-size:16px;color:#1B6CA8;font-weight:600;margin-top:16px;">031 566 0800</a>
</div>


<!-- ═══════════════════════════════════════════
     HERO
════════════════════════════════════════════ -->
<section id="home" class="hero-split flex" style="min-height:100vh;padding-top:72px;">
  <div class="hero-left flex flex-col justify-center" style="width:50%;padding:60px 56px 60px 64px;">
    <div class="fade-up" style="margin-bottom:28px;">
      <span style="display:inline-flex;align-items:center;gap:8px;background:#EEF4FB;border:1px solid #D6EAF8;color:#1B6CA8;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;padding:8px 18px;border-radius:9999px;">
        🌊 Umhlanga's #1 Property Agency
      </span>
    </div>
    <h1 class="fade-up delay-100 hero-h1" style="font-family:'DM Serif Display',serif;font-size:clamp(52px,5.5vw,80px);line-height:1.05;color:#1A2332;margin-bottom:24px;">
      Find Your<br/>Perfect<br/><span style="color:#1B6CA8;font-style:italic;">Coastal</span> Home.
    </h1>
    <p class="fade-up delay-200" style="font-family:'DM Sans',sans-serif;font-size:18px;color:#6B7C93;line-height:1.65;max-width:460px;margin-bottom:36px;">
      Premium residential and commercial properties across Umhlanga, La Lucia, Ballito and the KZN North Coast.
    </p>

    <!-- Search Bar -->
    <div class="fade-up delay-300" style="background:#fff;border:1.5px solid #1B6CA8;border-radius:14px;box-shadow:0 8px 40px rgba(27,108,168,0.12);overflow:hidden;margin-bottom:28px;">
      <div class="search-bar-grid flex" style="min-height:60px;">
        <select id="search-location" class="search-input flex-1" style="border:none;padding:16px 20px;font-family:'DM Sans',sans-serif;font-size:14px;color:#1A2332;background:transparent;cursor:pointer;border-right:1px solid #CBD5E1;" aria-label="Location">
          <option value="">📍 Location</option>
          <option value="umhlanga-ridge">Umhlanga Ridge</option>
          <option value="umhlanga-rocks">Umhlanga Rocks</option>
          <option value="la-lucia">La Lucia</option>
          <option value="ballito">Ballito</option>
          <option value="umhlanga">Umhlanga</option>
        </select>
        <select id="search-type" class="search-input flex-1" style="border:none;padding:16px 20px;font-family:'DM Sans',sans-serif;font-size:14px;color:#1A2332;background:transparent;cursor:pointer;border-right:1px solid #CBD5E1;" aria-label="Property type">
          <option value="">🏠 Property Type</option>
          <option value="sale">For Sale</option>
          <option value="let">To Let</option>
          <option value="commercial">Commercial</option>
        </select>
        <select id="search-price" class="search-input flex-1" style="border:none;padding:16px 20px;font-family:'DM Sans',sans-serif;font-size:14px;color:#1A2332;background:transparent;cursor:pointer;border-right:1px solid #CBD5E1;" aria-label="Price range">
          <option value="">💰 Price Range</option>
          <option value="0-2000000">Under R2M</option>
          <option value="2000000-5000000">R2M — R5M</option>
          <option value="5000000-10000000">R5M — R10M</option>
          <option value="10000000-20000000">R10M — R20M</option>
          <option value="20000000-999999999">R20M+</option>
        </select>
        <button id="search-btn" class="btn-ocean" style="padding:16px 28px;font-family:'DM Sans',sans-serif;font-size:14px;font-weight:700;letter-spacing:0.06em;border:none;cursor:pointer;border-radius:0;" aria-label="Search properties">SEARCH</button>
      </div>
    </div>

    <div class="fade-up delay-400 flex flex-wrap gap-3">
      {[{val:'240+',label:'Active Listings'},{val:'R2.4B+',label:'Sold'},{val:'15 Years',label:'in KZN'}].map(s => (
        <div style="display:flex;align-items:center;gap:10px;background:#F7F9FC;border:1px solid #CBD5E1;border-radius:9999px;padding:10px 20px;">
          <span style="font-family:'DM Serif Display',serif;font-size:16px;font-weight:700;color:#1B6CA8;">{s.val}</span>
          <span style="font-family:'DM Sans',sans-serif;font-size:13px;color:#6B7C93;">{s.label}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="hero-right" style="width:50%;position:relative;overflow:hidden;">
    <div id="hero-panel-0" class="hero-panel active" data-location="Umhlanga Ridge" data-sublabel="UMHLANGA RIDGE, DURBAN" aria-hidden="false">
      <img src="/images/umhlanga-ridge.jpg" alt="Coastal apartment — Umhlanga Ridge" class="hero-img-real" loading="eager"/>
    </div>
    <div id="hero-panel-1" class="hero-panel" data-location="La Lucia Beachfront" data-sublabel="LA LUCIA, DURBAN NORTH" aria-hidden="true">
      <img src="/images/la-lucia-beachfront.jpg" alt="Beachfront villa — La Lucia" class="hero-img-real" loading="lazy"/>
    </div>
    <div id="hero-panel-2" class="hero-panel" data-location="Umhlanga Rocks" data-sublabel="UMHLANGA ROCKS, DURBAN" aria-hidden="true">
      <img src="/images/umhlanga-rocks.jpg" alt="Luxury interior — Umhlanga Rocks" class="hero-img-real" loading="lazy"/>
    </div>
    <div id="hero-location-bar" style="position:absolute;bottom:0;left:0;right:0;z-index:5;padding:32px 28px;background:linear-gradient(to top,rgba(10,30,50,0.65),transparent);pointer-events:none;">
      <p id="hero-active-location" style="font-family:'DM Serif Display',serif;font-size:20px;font-style:italic;color:#fff;margin-bottom:4px;">Umhlanga Ridge</p>
      <p id="hero-active-sublabel" style="font-family:'DM Sans',sans-serif;font-size:11px;letter-spacing:0.14em;color:rgba(255,255,255,0.65);">UMHLANGA RIDGE, DURBAN</p>
    </div>
    <div style="position:absolute;left:-110px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:12px;z-index:10;">
      {[
        {price:'R4.2M',loc:'Umhlanga Ridge',idx:0},
        {price:'R12.5M',loc:'La Lucia Beachfront',idx:1},
        {price:'R8.9M',loc:'Umhlanga Rocks',idx:2},
      ].map(t => (
        <button class={`thumb-card hero-thumb fade-up delay-${(t.idx+3)*100}${t.idx===0?' thumb-active':''}`} data-panel={t.idx}
          style="width:220px;background:#fff;border-radius:12px;box-shadow:0 8px 32px rgba(27,108,168,0.18);overflow:hidden;display:flex;align-items:stretch;border:none;padding:0;cursor:pointer;text-align:left;">
          <div class="thumb-bar" style="width:56px;background:linear-gradient(135deg,#1A2332,#2E8BC0);flex-shrink:0;display:flex;align-items:center;justify-content:center;">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2" y="6" width="14" height="10" rx="1" stroke="white" stroke-width="1.5"/><path d="M6 16V11h6v5" stroke="white" stroke-width="1.5"/><path d="M1 7l8-5 8 5" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>
          </div>
          <div style="padding:12px 14px;">
            <div style="font-family:'DM Serif Display',serif;font-size:14px;font-weight:700;color:#1B6CA8;">{t.price}</div>
            <div style="font-family:'DM Sans',sans-serif;font-size:11px;color:#6B7C93;margin-top:3px;">📍 {t.loc}</div>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<style>
  .btn-ocean { background:#1B6CA8;color:#fff;text-decoration:none;display:inline-block;transition:background 0.2s ease; }
  .btn-ocean:hover { background:#2E8BC0; }
  .nav-link { transition:color 0.2s ease; }
  .nav-link:hover { color:#1B6CA8 !important; }
  .hero-panel { position:absolute;inset:0;opacity:0;transform:scale(1.04);transition:opacity 0.55s ease,transform 0.55s ease;pointer-events:none; }
  .hero-panel.active { opacity:1;transform:scale(1);pointer-events:auto; }
  .hero-img-real { position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center; }
  .hero-panel::after { content:'';position:absolute;inset:0;background:linear-gradient(to bottom,rgba(0,0,0,0.08) 0%,transparent 40%,rgba(10,25,45,0.45) 100%);pointer-events:none; }
  .thumb-active { box-shadow:0 8px 40px rgba(27,108,168,0.35) !important;outline:2.5px solid #1B6CA8; }
  .thumb-active .thumb-bar { background:linear-gradient(135deg,#1B6CA8,#2E8BC0) !important; }

  /* ── Card hidden state for filtering ── */
  .prop-card { transition:transform 0.3s ease,box-shadow 0.3s ease,opacity 0.3s ease; }
  .prop-card.hidden-card { display:none; }
  .prop-card.filtered-out { opacity:0.25;pointer-events:none;transform:scale(0.97); }

  /* ── No results message ── */
  #no-results { display:none;text-align:center;padding:48px 24px;grid-column:1/-1; }
  #no-results.visible { display:block; }
</style>


<!-- ═══════════════════════════════════════════
     FILTER BAR
════════════════════════════════════════════ -->
<section style="background:#1B6CA8;padding:48px 24px;">
  <div style="max-width:900px;margin:0 auto;text-align:center;">
    <h3 class="fade-up" style="font-family:'DM Serif Display',serif;font-size:clamp(24px,3vw,36px);font-style:italic;color:#fff;margin-bottom:28px;">
      850+ Properties Across the KZN Coast
    </h3>
    <div class="fade-up delay-100 flex flex-wrap justify-center gap-3">
      <button class="filter-pill active" data-filter="all">All Properties</button>
      <button class="filter-pill" data-filter="sale">For Sale</button>
      <button class="filter-pill" data-filter="let">To Let</button>
      <button class="filter-pill" data-filter="commercial">Commercial</button>
    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     FEATURED LISTINGS
════════════════════════════════════════════ -->
<section id="buy" style="background:#ffffff;padding:96px 24px;">
  <div style="max-width:1200px;margin:0 auto;">
    <div class="fade-up text-center" style="margin-bottom:64px;">
      <span class="section-label">FEATURED LISTINGS</span>
      <h2 id="listings-heading" style="font-family:'DM Serif Display',serif;font-size:clamp(36px,4vw,56px);color:#1A2332;margin:16px 0 0;line-height:1.1;">Handpicked Properties</h2>
      <span class="gold-line"></span>
      <p style="font-family:'DM Sans',sans-serif;font-size:17px;color:#6B7C93;margin-top:20px;max-width:520px;margin-left:auto;margin-right:auto;line-height:1.65;">
        Our agents personally curate every listing on Pinnacle Realty.
      </p>
    </div>

    <!-- Property Grid -->
    <div id="listings-grid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;" class="listings-grid">

      {properties.map((p, idx) => (
        <article
          class={`prop-card fade-up${idx>0?` delay-${Math.min(idx*100,500)}`:''}`}
          data-id={p.id}
          data-type={p.type}
          data-location={p.locationKey}
          data-price-num={p.priceNum}
          style="background:#fff;border-radius:16px;box-shadow:0 4px 24px rgba(27,108,168,0.08);overflow:hidden;border:1px solid #f0f4f8;"
        >
          <div style="position:relative;height:240px;overflow:hidden;">
            <div class="card-img" style={`height:100%;background:${p.imgGrad};display:flex;align-items:center;justify-content:center;`}>
              <span style="font-family:'DM Serif Display',serif;font-size:15px;font-style:italic;color:rgba(255,255,255,0.6);">[Property Photo]</span>
            </div>
            <span style={`position:absolute;top:16px;left:16px;background:${p.badgeColor};color:#fff;font-family:'DM Sans',sans-serif;font-size:11px;font-weight:700;letter-spacing:0.08em;padding:5px 12px;border-radius:9999px;`}>{p.badge}</span>
            <button
              class="heart-icon"
              data-id={p.id}
              style="position:absolute;top:14px;right:14px;background:rgba(255,255,255,0.9);border:none;border-radius:9999px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:16px;"
              aria-label="Save property"
            >♡</button>
          </div>
          <div style="padding:20px;">
            <div style="font-family:'DM Serif Display',serif;font-size:22px;font-weight:700;color:#1B6CA8;margin-bottom:6px;">{p.price}</div>
            <div style="font-family:'DM Sans',sans-serif;font-size:14px;font-weight:600;color:#1A2332;margin-bottom:6px;">{p.name}</div>
            <div style="font-family:'DM Sans',sans-serif;font-size:13px;color:#6B7C93;margin-bottom:16px;">📍 {p.location}</div>
            <div style="display:flex;border-top:1px solid #EEF4FB;padding-top:14px;margin-bottom:14px;">
              {p.type === 'commercial'
                ? [['🏢','Open Plan'],['📐',`${p.size}m²`],['🚗',`${p.parking} Park`],['✓','Prime']].map((f,i) => (
                    <span style="font-family:'DM Sans',sans-serif;font-size:12px;color:#6B7C93;flex:1;text-align:center;border-right:i<3?'1px solid #CBD5E1':'none';">{f[0]} {f[1]}</span>
                  ))
                : [['🛏',`${p.beds} Beds`],['🚿',`${p.baths} Baths`],['📐',`${p.size}m²`],['🚗',`${p.parking}`]].map((f,i) => (
                    <span style="font-family:'DM Sans',sans-serif;font-size:12px;color:#6B7C93;flex:1;text-align:center;border-right:i<3?'1px solid #CBD5E1':'none';">{f[0]} {f[1]}</span>
                  ))
              }
            </div>
            <div style="border-top:1px solid #EEF4FB;padding-top:14px;display:flex;align-items:center;justify-content:space-between;">
              <button class="view-link open-modal" data-id={p.id} style="font-family:'DM Sans',sans-serif;font-size:13px;font-weight:600;color:#1B6CA8;background:none;border:none;cursor:pointer;padding:0;">View Property →</button>
